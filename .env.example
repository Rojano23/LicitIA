# Manual/development template. Canonical UAT: licitia_local.py configure (private generated secret).
# Set a private DB URL explicitly; never use a shared validation database.
DATABASE_URL=postgresql+psycopg://licitia:REPLACE_WITH_GENERATED_SECRET@127.0.0.1:55432/licitia_uat
APP_ENV=limited-uat
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
# Replace with an absolute writable directory on your machine.
LICITIA_DATA_DIR=/absolute/path/to/licitia-uat/data
LICITIA_LOCAL_AI_ENABLED=false
LICITIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LICITIA_OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
# TESSDATA_PREFIX must point to a preinstalled directory containing spa.traineddata and eng.traineddata.
# TESSDATA_PREFIX=/absolute/path/to/tessdata
